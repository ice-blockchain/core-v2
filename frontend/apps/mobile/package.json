{
  "name": "@ion/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator 'iPhone 16 Pro'",
    "ios:staging": "../../scripts/setup-env.sh staging && rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && react-native run-ios --scheme Ion-Staging --simulator 'iPhone 16 Pro'",
    "ios:testnet": "../../scripts/setup-env.sh testnet && react-native run-ios --scheme Ion-Testnet --simulator 'iPhone 16 Pro'",
    "ios:production": "../../scripts/setup-env.sh production && react-native run-ios --scheme Ion-Production --simulator 'iPhone 16 Pro'",
    "android:staging": "../../scripts/setup-env.sh staging && react-native run-android --mode stagingDebug --appId io.ion.app.staging",
    "android:testnet": "../../scripts/setup-env.sh testnet && react-native run-android --mode ionTestnetDebug --appId io.ion.app.testnet",
    "android:production": "../../scripts/setup-env.sh production && react-native run-android --mode productionDebug --appId io.ion.app",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@gorhom/portal": "^1.0.14",
    "@ion/auth": "workspace:*",
    "@ion/auth-ui": "workspace:*",
    "@ion/chat": "workspace:*",
    "@ion/config": "workspace:*",
    "@ion/identity-client": "workspace:*",
    "@ion/localization": "workspace:*",
    "@ion/media-viewer": "workspace:*",
    "@ion/navigation": "workspace:*",
    "@ion/network": "workspace:*",
    "@ion/nsfw-detection": "workspace:*",
    "@ion/onboarding-ui": "workspace:*",
    "@ion/splash-ui": "workspace:*",
    "@ion/ui": "workspace:*",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "lottie-react-native": "^7.3.6",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-config": "^1.6.1",
    "react-native-create-thumbnail": "^2.2.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-nitro-tflite": "^0.0.1",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-video": "^6.19.1",
    "react-native-worklets": "^0.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/assets-registry": "0.84.1",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/codegen": "0.84.1",
    "@react-native/community-cli-plugin": "0.84.1",
    "@react-native/debugger-frontend": "0.84.1",
    "@react-native/dev-middleware": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/gradle-plugin": "0.84.1",
    "@react-native/js-polyfills": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/normalize-colors": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@react-native/virtualized-lists": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "hermes-compiler": "250829098.0.9",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}