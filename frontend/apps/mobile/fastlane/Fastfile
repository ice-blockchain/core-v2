dotenv_path = File.expand_path('../.env.secrets', __dir__)
Dotenv.load(dotenv_path) if File.exist?(dotenv_path)

default_platform(:ios)

platform :ios do
  desc "Fetch certificates and profiles for appstore, adhoc, and development"
  lane :fetch_certs do
    ["appstore", "adhoc", "development"].each do |type|
      match(type: type, readonly: true)
    end
  end

  desc "Configure code signing settings for the build target"
  lane :setup_signing do
    environment = ENV["INPUT_ENVIRONMENT"]
    deployment_target = ENV["INPUT_DEPLOYMENT_TARGET"]

    bundle_ids = {
      "staging" => "io.ion.app.staging",
      "testnet" => "io.ion.app.testnet",
      "production" => "io.ion.app"
    }
    bundle_id = bundle_ids[environment]
    UI.user_error!("Unknown environment: #{environment}") unless bundle_id

    sign_type = deployment_target == "store" ? "AppStore" : "AdHoc"
    profile_name = "match #{sign_type} #{bundle_id}"

    config_suffix = environment.capitalize

    update_code_signing_settings(
      path: "ios/mobile.xcodeproj",
      targets: ["mobile"],
      team_id: "YJJ6X8TG5Y",
      profile_name: profile_name,
      code_sign_identity: "iPhone Distribution",
      build_configurations: ["Release-#{config_suffix}"]
    )
  end

  desc "Renew and push certificates and profiles for appstore, adhoc, and development"
  lane :update_certs do
    ["appstore", "adhoc", "development"].each do |type|
      match(type: type, readonly: false)
    end
  end

  desc "Distribute IPA to Firebase App Distribution"
  lane :distribute_firebase do
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_IOS"],
      ipa_path: Dir[File.expand_path("../ios/build/export/*.ipa", __dir__)].first,
      service_credentials_file: "fastlane/keys/firebase-distribution.json"
    )
  end

  desc "Upload IPA to App Store Connect"
  lane :distribute_appstore do
    api_key = app_store_connect_api_key(
      key_filepath: "fastlane/keys/appstore-connect-key.json",
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key,
      ipa: Dir[File.expand_path("../ios/build/export/*.ipa", __dir__)].first,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :android do
  desc "Distribute APK to Firebase App Distribution"
  lane :distribute_firebase do
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"],
      android_artifact_path: Dir[File.expand_path("../android/app/build/outputs/apk/**/*-release.apk", __dir__)].first,
      service_credentials_file: "fastlane/keys/firebase-distribution.json"
    )
  end

  desc "Upload AAB to Google Play Store"
  lane :distribute_playstore do
    supply(
      aab: Dir[File.expand_path("../android/app/build/outputs/bundle/**/*-release.aab", __dir__)].first,
      json_key: "fastlane/keys/gp-console.json",
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
