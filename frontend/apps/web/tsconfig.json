{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["node_modules"]
}
