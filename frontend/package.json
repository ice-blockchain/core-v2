{
  "name": "ion-app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "ios:staging": "pnpm --filter @ion/mobile ios:staging",
    "ios:testnet": "pnpm --filter @ion/mobile ios:testnet",
    "ios:production": "pnpm --filter @ion/mobile ios:production",
    "android:staging": "pnpm --filter @ion/mobile android:staging",
    "android:testnet": "pnpm --filter @ion/mobile android:testnet",
    "android:production": "pnpm --filter @ion/mobile android:production",
    "web": "pnpm --filter @ion/web dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.32.1"
}
